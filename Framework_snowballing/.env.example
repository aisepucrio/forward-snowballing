# Copie este arquivo para .env e ajuste o que precisar:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
#
# O .env nunca deve ser commitado.

# ---------------------------------------------------------------------------
# Banco de dados (usado pelo docker-compose e pela aplicação)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=snowmap_bd
DB_USER=postgres
DB_PASSWORD=postgres

# Se você já tem um PostgreSQL instalado na máquina, ele ocupa a 5432 e o
# container não sobe. Nesse caso use DB_PORT=5433 — o valor vale para os dois
# lados: o docker-compose publica nessa porta e a aplicação conecta nela.

# Usuário fixo enquanto não existe sistema de login.
# Precisa existir na tabela users, senão nenhuma busca é gravada.
TEMP_USER_ID=00000000-0000-0000-0000-000000000001

# ---------------------------------------------------------------------------
# Servidor web
# ---------------------------------------------------------------------------
PORT=3000

# ---------------------------------------------------------------------------
# Semantic Scholar (opcional)
# ---------------------------------------------------------------------------
# Sem chave a API funciona, mas com limite de requisições bem menor.
# Solicite em https://www.semanticscholar.org/product/api
SEMANTIC_API_KEY=

# ---------------------------------------------------------------------------
# Ollama — triagem por LLM (opcional)
# ---------------------------------------------------------------------------
# Só é usado na página de Critérios. A interface permite sobrescrever a URL e
# o modelo em tempo de execução; os valores abaixo são o padrão.
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2:3b

# Quantos artigos por requisição à LLM (padrão 10) e quantas requisições em
# paralelo (padrão 1). Aumente com cuidado: o Ollama local costuma degradar.
LLM_BATCH_SIZE=10
LLM_MAX_WORKERS=1
